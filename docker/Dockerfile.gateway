# Estágio 1: Build da aplicação Frontend SPA (React 19 + TypeScript + Vite)
FROM node:20-alpine AS build-web
WORKDIR /app
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# Estágio 2: Nginx Gateway de Produção
FROM nginx:1.27-alpine
COPY --from=build-web /app/dist /usr/share/nginx/html
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/includes /etc/nginx/includes
COPY docker/nginx/swagger /usr/share/nginx/swagger

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
